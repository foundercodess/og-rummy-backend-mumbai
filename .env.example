PORT=3000
NODE_ENV=development
REDIS_URL=redis://localhost:6379
# Mumbai ElastiCache Serverless (production):
# REDIS_URL=rediss://redis-cache-mumbai-xxxxx.serverless.aps1.cache.amazonaws.com:6379

# Optional for async eventing (Kafka not required for initial local gameplay dev)
# KAFKA_BROKERS=localhost:9094
# KAFKA_CLIENT_ID=og-rummy-backend

# PostgreSQL (optional - docker-compose sets this for local)
# Virginia RDS:
# DATABASE_URL=postgresql://postgres:PASSWORD@og-rummy-db.cu7wcwuo4gcw.us-east-1.rds.amazonaws.com:5432/postgres
# Mumbai RDS:
DATABASE_URL=postgresql://postgres:PASSWORD@og-rummy-db-mumbai.c9eqi4ou0bv9.ap-south-1.rds.amazonaws.com:5432/postgres

# JWT for auth (required for login/session)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# OTP provider
OTP_PROVIDER_URL=https://indopay.cloud/otp/newsend_otp.php
OTP_MERCHANT_KEY=689744ecd79d75849010c9ebc13605eb122e943d7851f868
OTP_DIGITS=4
OTP_EXPIRY_MINUTES=10

# AWS S3 for uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
# Optional: override if using CloudFront or custom domain
# AWS_S3_BASE_URL=https://cdn.your-domain.com

# GiftAura payment gateway (Add Cash / pay-in)
GIFTAURA_PG_API_URL=https://pgapi.giftaura.shop/paynow
GIFTAURA_PAYIN_STATUS_API_URL=https://pgapi.giftaura.shop/payinstatus
GIFTAURA_MERCHANT_ID=INDIANPAY00GIFTAURA00004
GIFTAURA_PG_TYPE=2
GIFTAURA_REMARK=Add Cash
# Public API base URL (used to build redirect URL when GIFTAURA_REDIRECT_URL is not set)
PUBLIC_API_BASE_URL=https://your-api-domain.com
# Public URL PG redirects to after payment (must be reachable by PG servers)
GIFTAURA_REDIRECT_URL=https://your-api-domain.com/api/wallet/payment-callback

# Background sync for pending add-cash / pay-in (like withdrawal payout sync)
RECHARGE_PAYIN_SYNC_ENABLED=true
RECHARGE_PAYIN_SYNC_CRON=*/10 * * * *
RECHARGE_PAYIN_SYNC_MIN_AGE_MINUTES=2
RECHARGE_PAYIN_SYNC_BATCH_LIMIT=50

# GiftAura payout gateway (Withdrawals — base64 salt payload)
GIFTAURA_PAYOUT_API_URL=https://pgapi.giftaura.shop/single_transaction
GIFTAURA_MERCHANT_TOKEN=your-merchant-secret-token
GIFTAURA_PAYOUT_REMARK=Withdrawal
GIFTAURA_PAYOUT_HISTORY_API_URL=https://pgapi.giftaura.shop/merchantpayouthistory
WITHDRAWAL_PAYOUT_SYNC_ENABLED=true
WITHDRAWAL_PAYOUT_SYNC_CRON=*/10 * * * *
WITHDRAWAL_PAYOUT_SYNC_MIN_AGE_MINUTES=2
WITHDRAWAL_PAYOUT_SYNC_BATCH_LIMIT=50
WITHDRAWAL_FEE_RATE=0.04
WITHDRAWAL_MIN_AMOUNT=100
WITHDRAWAL_DAILY_MAX_COUNT=10
WITHDRAWAL_DAILY_MAX_AMOUNT=100000
MAX_BANK_ACCOUNTS_PER_USER=5
# Require approved KYC before withdrawals (set to false only for local testing)
WITHDRAWAL_REQUIRE_APPROVED_KYC=true
# Dev/staging only (ignored when NODE_ENV=production): skip withdrawable balance checks for payout testing
# BYPASS_WITHDRAWAL_BALANCE_CHECK=true

# Firebase Cloud Messaging (push notifications)
# Base64-encoded Firebase service account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Or mount JSON file path inside container
FIREBASE_SERVICE_ACCOUNT_PATH=
FCM_ANDROID_CHANNEL_ID=og_rummy_default

# Bot drop policy (pool/points) — bots now play to win when pool score has headroom
# BOT_STRATEGIC_DROP_ENABLED=true
# BOT_DROP_BENEFIT_THRESHOLD=28
# BOT_POOL_COMFORTABLE_HEADROOM=45
# BOT_POOL_NEAR_ELIMINATION_HEADROOM=28
# BOT_EARLY_DROP_MIN_MARGIN=35
# BOT_EARLY_DROP_DEAD_HAND_ENABLED=true
# BOT_HOPELESS_DISPLAY_POINT=58
# BOT_HOPELESS_TURN_MIN=5
# ENABLE_BOT_SOFT_RIGGING=false
# Soft CPU budget for bot finish-card search (ms). Under load stops after ≥1 valid candidate.
# BOT_FINISH_EVAL_BUDGET_MS=45
# BOT_FINISH_EVAL_WARN_MS=25
# BOT_FINISH_EARLY_EXIT_UTILITY=1650

# Gameplay audit trail: default is async (non-blocking). Set true only for tests that assert events immediately.
# GAME_SESSION_EVENTS_AWAIT=false

# ── Reliable-architecture Phase 1: session-state read cache (Redis) ──────────────
# Read-through cache for the two hot session reads (session row + players join).
# Postgres remains the source of truth; cache is invalidated on every write and
# has a short TTL backstop. DEFAULT OFF — behavior is unchanged until set to true.
# Enable only after validating in a test environment (watch for turn desync).
# SESSION_STATE_CACHE_ENABLED=false
# Staleness backstop in ms if any write path is ever missed (default 3000).
# SESSION_STATE_CACHE_TTL_MS=3000

# Deal fairness (server-only; not exposed to clients)
# DEAL_SHUFFLE_CANDIDATE_COUNT=5
# DEAL_TOP_CANDIDATE_WINDOW=2
# DEAL_RANDOM_PICK_PROBABILITY=0.05
# DEAL_FAIRNESS_PLAYABILITY_WEIGHT=0.27

# Stale game_sessions cleanup (waiting/ready only; never active/completed). Cron runs on server boot unless disabled.
# STALE_SESSION_CLEANUP_ENABLED=false
# STALE_SESSION_CANCEL_AFTER_HOURS=2
# STALE_SESSION_CLEANUP_MAX_BATCH=500
# STALE_SESSION_CLEANUP_CRON=0 */2 * * *
# STALE_SESSION_CLEANUP_TZ=Asia/Kolkata

# Admin wallet credit PIN (comma-separated). Required for POST /admin/wallet/credit.
# If unset, falls back to APK upload PINs in admin.controller.js.
# ADMIN_WALLET_CREDIT_PIN=8842

# Pending table-rejoin window after disconnect (minutes). Default 15.
# REJOIN_PENDING_MAX_AGE_MINUTES=15
