PORT=3000
NODE_ENV=development
REDIS_URL=redis://localhost:6379
# Mumbai ElastiCache Serverless (production):
# REDIS_URL=rediss://redis-cache-mumbai-xxxxx.serverless.aps1.cache.amazonaws.com:6379

# Optional for async eventing (Kafka not required for initial local gameplay dev)
# KAFKA_BROKERS=localhost:9094
# KAFKA_CLIENT_ID=og-rummy-backend

# PostgreSQL (optional - docker-compose sets this for local)
# Virginia RDS:
# DATABASE_URL=postgresql://postgres:PASSWORD@og-rummy-db.cu7wcwuo4gcw.us-east-1.rds.amazonaws.com:5432/postgres
# Mumbai RDS:
DATABASE_URL=postgresql://postgres:PASSWORD@og-rummy-db-mumbai.c9eqi4ou0bv9.ap-south-1.rds.amazonaws.com:5432/postgres

# JWT for auth (required for login/session)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# OTP provider
OTP_PROVIDER_URL=https://indopay.cloud/otp/newsend_otp.php
OTP_MERCHANT_KEY=689744ecd79d75849010c9ebc13605eb122e943d7851f868
OTP_DIGITS=4
OTP_EXPIRY_MINUTES=10

# AWS S3 for uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
# Optional: override if using CloudFront or custom domain
# AWS_S3_BASE_URL=https://cdn.your-domain.com

# Stale game_sessions cleanup (waiting/ready only; never active/completed). Cron runs on server boot unless disabled.
# STALE_SESSION_CLEANUP_ENABLED=false
# STALE_SESSION_CANCEL_AFTER_HOURS=2
# STALE_SESSION_CLEANUP_MAX_BATCH=500
# STALE_SESSION_CLEANUP_CRON=0 */2 * * *
# STALE_SESSION_CLEANUP_TZ=Asia/Kolkata
